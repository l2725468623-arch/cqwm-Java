<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.DishFlavorMapper">
 <insert id="insertBatch">INSERT INTO dish_flavor(dish_id,name,`value`) VALUES <foreach collection="flavors" item="f" separator=",">(#{f.dishId},#{f.name},#{f.value})</foreach></insert>
 <select id="getByDishId" resultType="com.sky.entity.DishFlavor">SELECT * FROM dish_flavor WHERE dish_id=#{dishId} ORDER BY id</select>
 <delete id="deleteByDishIds">DELETE FROM dish_flavor WHERE dish_id IN <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach></delete>
</mapper>
